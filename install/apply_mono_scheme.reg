"SizeWE"="D:\\MonoCurseher\\dist\\mono_horizontal_resize.cur"
"SizeNWSE"="D:\\MonoCurseher\\dist\\mono_diagonal_resize_1.cur"
"SizeNESW"="D:\\MonoCurseher\\dist\\mono_diagonal_resize_2.cur"
